@using BlazorBootstrap;

<Sidebar2 @ref="_sidebar"
          Href="/"
          ImageSrc="https://demos.blazorbootstrap.com/images/logo/logo-white.svg"
          Title="SettlementTracker"
          BadgeText="0.0.1"
          DataProvider="Sidebar2DataProvider"
          WidthUnit="Unit.Px"/>

@code {
    private Sidebar2 _sidebar = default!;

    private IEnumerable<NavItem> _navItems = default!;

    private async Task<Sidebar2DataProviderResult> Sidebar2DataProvider(Sidebar2DataProviderRequest request)
    {
        if (_navItems is null)
            _navItems = GetNavItems();

        return await Task.FromResult(request.ApplyTo(_navItems));
    }

    private IEnumerable<NavItem> GetNavItems()
    {
        _navItems = new List<NavItem>
        {
            new NavItem { Id = "1", Href = "/", IconName = IconName.HouseDoorFill, Text = "Home", Match = NavLinkMatch.All },
            new NavItem { Id = "2", Href = "/citizens", IconName = IconName.PersonFill, Text = "Горожанe" },
            new NavItem { Id = "3", Href = "/buildings", IconName = IconName.House, Text = "Здания" },
            new NavItem { Id = "4", Href = "/buildings_alt", IconName = IconName.House, Text = "Здания_alt" },
        };

        return _navItems;
    }
    
    

    public void ToggleSidebar() => _sidebar.ToggleSidebar();
}