@inherits LayoutComponentBase

@using BlazorBootstrap
@using SettlementTracker.WebInterface.Components.Pages.ResourcesPages

<BlazorBootstrapLayout StickyHeader="true">
    <HeaderSection>
        <Icon Name="IconName.List" role="button" @onclick="@(() => _navMenu.ToggleSidebar())"/>
        <CascadingValue Value="@_resourceStatistics" Name="ResourcesStatisticsPanel">
            <ResourceStatisticsButton/>
        </CascadingValue>
        <ThemeSwitcher Class="ps-3 ps-lg-2"/>
    </HeaderSection>

    <SidebarSection>
        <NavMenu @ref="_navMenu"/>
    </SidebarSection>
    <ContentSection>
        @Body
    </ContentSection>

    <FooterSection>
        @* Footer links... *@
    </FooterSection>
</BlazorBootstrapLayout>

<ResourcesStatisticsPrototype @ref="_resourceStatistics"/>

@code
{
    NavMenu _navMenu = default!;
    ResourcesStatisticsPrototype _resourceStatistics = default!;
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>