@page "/citizens"
@using SettlementTracker.Core.Models.Entities
@using SettlementTracker.Core.Models.Enums
@using SettlementTracker.WebInterface.Data.Services
@using BlazorBootstrap;

@inject ICitizenService CitizenService

@rendermode InteractiveServer

<PageTitle>Горожанe - Settlement Tracker</PageTitle>

<h1>Управление горожанами</h1>

<Progress Class="mb-3">
    <ProgressBar Color="ProgressColor.Info" Width="@childRatio"/>
    <ProgressBar Color="ProgressColor.Success" Width="@adultRatio"/>
    <ProgressBar Color="ProgressColor.Warning" Width="@elderRatio"/>
    <ProgressBar Color="ProgressColor.Danger" Width="@slaveRatio"/>
</Progress>

<Progress Class="mb-3">
    <ProgressBar Color="ProgressColor.Info" Width="@maleRatio"/>
    <ProgressBar Color="ProgressColor.Success" Width="@(1 - maleRatio)"/>
</Progress>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="AddNewCitizen">
        <Icon Name="IconName.PersonPlusFill"></Icon> Добавить горожанина
    </button>
    <button class="btn btn-primary" @onclick="OpenGenerationForm">
        <Icon Name="IconName.PersonPlusFill"></Icon> Сгенерировать горожан
    </button>
</div>

@if (_citizens == null)
{
    <p>
        <em>Загрузка...</em>
    </p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
            <tr>
                <th>Имя</th>
                <th>Пол</th>
                <th>Возраст</th>
                <th>Категория</th>
                <th>Раб</th>
                <th>Статус работы</th>
                <th>Эффективность</th>
                <th>Действия</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var citizen in _citizens)
            {
                <tr>
                    <td>@citizen.Name</td>
                    <td>@GetGenderDisplay(citizen.Gender)</td>
                    <td>@citizen.Age.ToString("F1") лет</td>
                    <td>
                        <span class="badge @GetAgeCategoryBadge(citizen.AgeCategory)">
                            @GetAgeCategoryDisplay(citizen.AgeCategory)
                        </span>
                    </td>
                    <td>
                        @if (citizen.IsSlave)
                        {
                            <Badge Color="BadgeColor.Danger">Да</Badge>
                        }
                        else
                        {
                            <Badge Color="BadgeColor.Success">Нет</Badge>
                        }
                    </td>
                    <td>@GetWorkStatusDisplay(citizen.WorkStatus)</td>
                    <td>@citizen.CurrentEfficiency.ToString("P0")</td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <Button Color="ButtonColor.Primary" Outline="true" @onclick="() => EditCitizen(citizen)">
                                <Icon Name="IconName.Pencil"></Icon>
                            </Button>
                            <Button Color="ButtonColor.Danger" Outline="true" @onclick="() => DeleteCitizen(citizen)">
                                <Icon Name="IconName.Trash"></Icon>
                            </Button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (_showEditDialog)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(_editingCitizen.Id == Guid.Empty ? "Новый горожанин" : "Редактирование горожанина")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseEditDialog"></button>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Имя</label>
                                <input type="text" class="form-control" @bind="_editingCitizen.Name"/>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Пол</label>
                                <select class="form-select" @bind="_editingCitizen.Gender">
                                    <option value="@Gender.Male">Мужской</option>
                                    <option value="@Gender.Female">Женский</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Возраст (лет)</label>
                                <input type="number" step="0.1" class="form-control"
                                       @bind="_editingCitizen.Age"/>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Статус работы</label>
                                <select class="form-select" @bind="_editingCitizen.WorkStatus">
                                    @foreach (WorkStatus status in Enum.GetValues(typeof(WorkStatus)))
                                    {
                                        <option value="@status">@GetWorkStatusDisplay(status)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4 mb-3 d-flex align-items-end">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox"
                                           @bind="_editingCitizen.IsSlave"/>
                                    <label class="form-check-label">Раб</label>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">ID здания/задания</label>
                                <input type="text" class="form-control"
                                       @bind="_editingCitizen.AssignedToId"/>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Тип назначения</label>
                                <input type="text" class="form-control"
                                       @bind="_editingCitizen.AssignedToType"/>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseEditDialog">
                        Отмена
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="SaveCitizen">
                        Сохранить
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showGenerateDialog)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        Сгенерировать новых горожан
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseGenerationForm"></button>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Раса</label>
                                <select class="form-select" @bind="_generationRace">
                                    <option value="Goblin">Гоблины</option>
                                    <option value="Human">Люди</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Пол</label>
                                <select class="form-select" @bind="_generationGender">
                                    <option value="@Gender.Male">Мужской</option>
                                    <option value="@Gender.Female">Женский</option>
                                    <option value="@Gender.Any">Случайный</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Возраст</label>
                                <select class="form-select" @bind="_generationAgeCategory">
                                    <option value="@AgeCategory.Child">Дети</option>
                                    <option value="@AgeCategory.Adult">Взрослые</option>
                                    <option value="@AgeCategory.Elder">Старики</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3 d-flex align-items-end">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox"
                                           @bind="_generationIsSlave"/>
                                    <label class="form-check-label">Рабы</label>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Количество</label>
                                <input type="number" step="1" class="form-control"
                                       @bind="_generationAmount"/>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseGenerationForm">
                        Отмена
                    </button>
                    <Button Color="ButtonColor.Primary" @onclick="GenerateCitizens">
                        Сгенерировать @(_generationRace == "Goblin" ? "гоблинов" : "людей")
                    </Button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    Random _random;
    private IEnumerable<Citizen>? _citizens;
    private bool _showEditDialog = false;
    private bool _showGenerateDialog = false;
    private Citizen _editingCitizen = new(Guid.NewGuid(), "", Gender.Male, 0);

    private float childRatio;
    private float adultRatio;
    private float elderRatio;
    private float slaveRatio;
    private float maleRatio;

    private Gender _generationGender;
    private string _generationRace = "Goblin";
    private AgeCategory _generationAgeCategory;
    private bool _generationIsSlave;
    private int _generationAmount = 1;

    protected override async Task OnInitializedAsync()
    {
        CitizenService.CitizensChange += OnCitizensChanged;

        await CitizenService.LoadFromFileAsync();
        _citizens = await CitizenService.GetCitizensAsync();
        _random = new(DateTime.Now.Millisecond);

        UpdateStatistics();
    }

    private void OnCitizensChanged(object? sender, EventArgs e)
    {
        UpdateStatistics();
    }

    private void UpdateStatistics()
    {
        if (_citizens == null)
        {
            return;
        }

        var freeCitizens = _citizens.Where(x => !x.IsSlave);

        float citizensCount = _citizens.Count();
        childRatio = freeCitizens.Count(x => x.AgeCategory == AgeCategory.Child) / citizensCount * 100;
        adultRatio = freeCitizens.Count(x => x.AgeCategory == AgeCategory.Adult) / citizensCount * 100;
        elderRatio = freeCitizens.Count(x => x.AgeCategory == AgeCategory.Elder) / citizensCount * 100;
        slaveRatio = (citizensCount - freeCitizens.Count()) / citizensCount * 100;
        maleRatio = _citizens.Count(x => x.Gender == Gender.Male) / citizensCount * 100;
    }

    private void AddNewCitizen()
    {
        _editingCitizen = new Citizen(Guid.Empty, "", Gender.Male, 0);
        _showEditDialog = true;
    }


    private void EditCitizen(Citizen citizen)
    {
        // Создаем копию для редактирования
        _editingCitizen = new Citizen(citizen.Id, citizen.Name, citizen.Gender, citizen.Age, citizen.IsSlave)
        {
            WorkStatus = citizen.WorkStatus,
            AssignedToId = citizen.AssignedToId,
            AssignedToType = citizen.AssignedToType,
            GuardianId = citizen.GuardianId,
            CurrentEfficiency = citizen.CurrentEfficiency
        };
        _showEditDialog = true;
    }

    private async Task SaveCitizen()
    {
        if (_editingCitizen.Id == Guid.Empty)
        {
            await CitizenService.AddCitizenAsync(_editingCitizen);
        }
        else
        {
            await CitizenService.UpdateCitizenAsync(_editingCitizen);
        }

        _citizens = await CitizenService.GetCitizensAsync();
        CloseEditDialog();
    }

    private async Task DeleteCitizen(Citizen citizen)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", $"Удалить горожанина {citizen.Name}?"))
        {
            await CitizenService.DeleteCitizenAsync(citizen.Id);
            _citizens = await CitizenService.GetCitizensAsync();
        }
    }

    private void CloseEditDialog()
    {
        _showEditDialog = false;
    }

    private void OpenGenerationForm()
    {
        _showGenerateDialog = true;
    }

    private void CloseGenerationForm()
    {
        _showGenerateDialog = false;
    }

    private async Task GenerateCitizens()
    {
        for (int i = 0; i < _generationAmount; i++)
        {
            Citizen generatedCitizen = GenerateCitizen();
            await CitizenService.AddCitizenAsync(generatedCitizen);
        }

        _citizens = await CitizenService.GetCitizensAsync();
    }

    private Citizen GenerateCitizen()
    {
        Gender gender = GenerateGender();
        string name = _generationRace == "Goblin" ? GenerateGoblinName(gender) : GenerateHumanName(gender);
        float age = GenerateAge();
        return new Citizen(Guid.Empty, name, gender, age, _generationIsSlave);
    }

