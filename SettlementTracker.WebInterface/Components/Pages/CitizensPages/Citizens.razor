    private Gender GenerateGender()
    {
        if (_generationGender == Gender.Any)
        {
            return _random.Next(100) < 50 ? Gender.Male : Gender.Female;
        }

        return _generationGender == Gender.Male ? Gender.Male : Gender.Female;
    }

    private float GenerateAge()
    {
        return _random.Next(60);
    }


    private string GetGenderDisplay(Gender gender)
    {
        return gender switch
        {
            Gender.Male => "♂ Мужской",
            Gender.Female => "♀ Женский",
            _ => gender.ToString()
        };
    }

    private string GetAgeCategoryDisplay(AgeCategory category)
    {
        return category switch
        {
            AgeCategory.Child => "Ребенок",
            AgeCategory.Adult => "Взрослый",
            AgeCategory.Elder => "Пожилой",
            _ => category.ToString()
        };
    }

    private string GetAgeCategoryBadge(AgeCategory category)
    {
        return category switch
        {
            AgeCategory.Child => "bg-info",
            AgeCategory.Adult => "bg-success",
            AgeCategory.Elder => "bg-warning",
            _ => "bg-secondary"
        };
    }

    private string GetWorkStatusDisplay(WorkStatus status)
    {
        return status switch
        {
            WorkStatus.Idle => "📝 Без дела",
            WorkStatus.AssignedToBuilding => "🔨 Приписан к зданию",
            WorkStatus.AssignedToJob => "🔨 На задании",
            WorkStatus.Caretaker => "Присматривает",
            _ => status.ToString()
        };
    }

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
}